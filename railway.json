{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn sistema_gonnet.wsgi --preload --bind 0.0.0.0:$PORT --workers ${WEB_CONCURRENCY:-2} --threads=2 --timeout=120 --max-requests=1000 --max-requests-jitter=50 --log-file -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
